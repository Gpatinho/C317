# Copie para .env e ajuste com os dados do seu MySQL local
DATABASE_URL="mysql://root:root@localhost:3306/observatorio"

PORT=3333
# Gere um segredo forte: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="troque-este-segredo"
JWT_EXPIRES_IN="8h"

# Endereço do front (Next.js) liberado no CORS
FRONTEND_URL="http://localhost:3000"

# Usuário administrador criado pelo seed
ADMIN_NOME="Equipe SMCELT"
ADMIN_EMAIL="admin@observatorio.local"
ADMIN_SENHA="admin123"

# Pasta dos PDFs dos relatórios (padrão: backend/uploads). Em produção, um volume persistente.
# UPLOADS_DIR="uploads"

# Em produção (NODE_ENV=production) a API recusa um JWT_SECRET com menos de 32 caracteres.
# NODE_ENV="production"
