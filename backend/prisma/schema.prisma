// Modelo de dados do Observatório do Turismo de SRS (Milestone III).
// Tabelas: usuario, indicador, estabelecimento, registro_indicador, relatorio,
// evento, atrativo e submissao (coleta pelos estabelecimentos).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Papel {
  ADMIN
  EDITOR
}

// Como somar os valores mensais de um indicador ao olhar um período maior:
// SOMA   -> fluxos (ex.: visitantes no período = soma dos meses)
// ULTIMO -> estoques (ex.: leitos existentes = valor do mês mais recente)
// MEDIA  -> taxas (ex.: ocupação média = média dos meses)
enum Agregacao {
  SOMA
  ULTIMO
  MEDIA
}

model Usuario {
  id                   Int                 @id @default(autoincrement())
  nome                 String              @db.VarChar(120)
  email                String              @unique @db.VarChar(160)
  senhaHash            String              @map("senha_hash") @db.VarChar(255)
  papel                Papel               @default(ADMIN)
  criadoEm             DateTime            @default(now()) @map("criado_em")
  registros            RegistroIndicador[]
  relatorios           Relatorio[]
  submissoesAnalisadas Submissao[] // envios dos estabelecimentos que este usuário aprovou/rejeitou

  @@map("usuario")
}

model Indicador {
  id                    Int                 @id @default(autoincrement())
  nome                  String              @db.VarChar(120)
  categoria             String              @db.VarChar(60) // setor: Hospedagem, Leitos, Empresas, Empregos, Visitantes...
  unidade               String              @db.VarChar(30)
  descricao             String?             @db.VarChar(255)
  agregacao             Agregacao           @default(SOMA)
  ativo                 Boolean             @default(true)
  // true = os estabelecimentos podem enviar este indicador pelo formulário de coleta
  coletaEstabelecimento Boolean             @default(false) @map("coleta_estabelecimento")
  registros             RegistroIndicador[]
  submissoes            Submissao[]

  @@unique([nome, categoria])
  @@index([categoria])
  @@map("indicador")
}

model Estabelecimento {
  id               Int                 @id @default(autoincrement())
  nome             String              @db.VarChar(160)
  categoria        String              @db.VarChar(60) // hotel, pousada, restaurante...
  endereco         String?             @db.VarChar(255)
  regiao           String?             @db.VarChar(80)
  // Hash (SHA-256) do código que o estabelecimento usa na coleta. O código em si nunca é salvo.
  codigoAcessoHash String?             @unique @map("codigo_acesso_hash") @db.Char(64)
  registros        RegistroIndicador[]
  submissoes       Submissao[]

  @@map("estabelecimento")
}

model RegistroIndicador {
  id                Int      @id @default(autoincrement())
  indicadorId       Int      @map("indicador_id")
  // NULL = valor consolidado do município (não vem de um estabelecimento específico)
  estabelecimentoId Int?     @map("estabelecimento_id")
  usuarioId         Int      @map("usuario_id")
  valor             Decimal  @db.Decimal(14, 2)
  periodo           DateTime @db.Date // sempre o 1º dia do mês de referência
  criadoEm          DateTime @default(now()) @map("criado_em")
  atualizadoEm      DateTime @updatedAt @map("atualizado_em")

  indicador       Indicador        @relation(fields: [indicadorId], references: [id], onDelete: Cascade)
  // Restrict: um estabelecimento com valores publicados não pode ser apagado. Com SetNull, os
  // valores dele virariam "valor do município" (estabelecimento_id NULL) e distorceriam o dashboard.
  estabelecimento Estabelecimento? @relation(fields: [estabelecimentoId], references: [id], onDelete: Restrict)
  usuario         Usuario          @relation(fields: [usuarioId], references: [id])
  submissao       Submissao? // preenchido quando o valor veio de um envio aprovado

  @@index([indicadorId, periodo])
  @@index([estabelecimentoId])
  @@map("registro_indicador")
}

model Relatorio {
  id           Int      @id @default(autoincrement())
  titulo       String   @db.VarChar(200)
  descricao    String?  @db.Text
  ano          Int?
  arquivoNome  String   @map("arquivo_nome") @db.VarChar(255) // nome original do PDF
  arquivoPath  String   @map("arquivo_path") @db.VarChar(255) // nome salvo em uploads/
  tamanhoBytes Int      @map("tamanho_bytes")
  publicadoEm  DateTime @default(now()) @map("publicado_em")
  usuarioId    Int      @map("usuario_id")
  usuario      Usuario  @relation(fields: [usuarioId], references: [id])

  @@map("relatorio")
}

// Agenda de eventos
model Evento {
  id         Int       @id @default(autoincrement())
  nome       String    @db.VarChar(160)
  dataInicio DateTime  @map("data_inicio") @db.Date
  dataFim    DateTime? @map("data_fim") @db.Date // NULL = evento de um dia só
  local      String    @db.VarChar(160)
  contato    String?   @db.VarChar(120) // site, @instagram, telefone...
  gratuito   Boolean   @default(true)
  icone      String?   @db.VarChar(8) // emoji exibido no card
  descricao  String?   @db.Text

  @@index([dataInicio])
  @@map("evento")
}

// Inventário Turístico  
enum TipoAtrativo {
  ATRATIVO // Oque motivou a a visita (igreja, cachoeira, festa, etc)
  EQUIPAMENTO // estrutura que atende o turista (hotel, restaurante, etc)
  SERVICO // Apoio (guia, agência, transporte, etc)
}

model Atrativo {
  id         Int          @id @default(autoincrement())
  nome       String       @db.VarChar(160)
  tipo       TipoAtrativo
  categoria  String       @db.VarChar(60) // Restaurante, Pico, Igreja, Hotel...
  descricao  String?      @db.Text
  endereco   String?      @db.VarChar(255)
  contato    String?      @db.VarChar(120)

  // Informações para o visitante (preenchidas pela SMCELT)
  horarioFuncionamento String? @map("horario_funcionamento") @db.VarChar(255) // ex.: "Seg a sex, 8h às 18h"
  melhorHorario        String? @map("melhor_horario") @db.VarChar(255) // melhor horário para visitar
  periodoMovimentado   String? @map("periodo_movimentado") @db.VarChar(255) // época do ano mais frequentada
  instagram            String? @db.VarChar(60) // só o usuário, sem @ (ex.: inatel)

  revisadoEm DateTime     @default(now()) @map("revisado_em") // última vez que alguém conferiu os dados

  @@index([tipo, categoria])
  @@map("atrativo")
}

// Coleta pelos estabelecimentos (item 6 da proposta)
// O hotel envia o próprio dado, que fica PENDENTE até a SMCELT aprovar.
// Ao aprovar, a API cria o registro_indicador e só então o valor aparece no dashboard.
enum StatusSubmissao {
  PENDENTE
  APROVADA
  REJEITADA
}

model Submissao {
  id                Int             @id @default(autoincrement())
  estabelecimentoId Int             @map("estabelecimento_id")
  indicadorId       Int             @map("indicador_id")
  valor             Decimal         @db.Decimal(14, 2)
  periodo           DateTime        @db.Date // 1º dia do mês de referência
  observacao        String?         @db.Text // comentário opcional do estabelecimento
  status            StatusSubmissao @default(PENDENTE)
  motivoRejeicao    String?         @map("motivo_rejeicao") @db.VarChar(255)
  enviadoEm         DateTime        @default(now()) @map("enviado_em")
  analisadoEm       DateTime?       @map("analisado_em")
  analisadoPorId    Int?            @map("analisado_por_id")
  registroId        Int?            @unique @map("registro_id") // registro criado na aprovação

  estabelecimento Estabelecimento    @relation(fields: [estabelecimentoId], references: [id], onDelete: Cascade)
  indicador       Indicador          @relation(fields: [indicadorId], references: [id], onDelete: Cascade)
  analisadoPor    Usuario?           @relation(fields: [analisadoPorId], references: [id], onDelete: SetNull)
  registro        RegistroIndicador? @relation(fields: [registroId], references: [id], onDelete: SetNull)

  @@index([status, enviadoEm])
  @@index([estabelecimentoId])
  @@map("submissao")
}
